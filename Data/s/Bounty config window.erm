****************************************************************************************************
* Selection helpers
****************************************************************************************************
!?FU(Bounty_SetSelection);              [x1 = 1 Modest, 2 Standard, 3 Generous]
!!VRx1&x1<1:S2;
!!VRx1&x1>3:S2;
!!SN:W^Bounty_Reward_Setting^/x1;


!?FU(Bounty_GetSelection);              [x1 = selected contract]
!!SN:W^Bounty_Reward_Setting^/?x1;
!!VRx1&x1<1:S2;
!!VRx1&x1>3:S2;


!?FU(Bounty_NormalizeSelection);
!!SN:W^Bounty_Reward_Setting^/?y1;
!!SN&y1<1:W^Bounty_Reward_Setting^/2;
!!SN&y1>3:W^Bounty_Reward_Setting^/2;


****************************************************************************************************
* Persistent Runtime configuration
****************************************************************************************************
!?FU(bounty_LoadOptionsFromIni);
!!VR(filePath:z):S^Runtime/bounty config.ini^;
!!FU(ReadIniInts):P(filePath)/^bounty^/
  ^Bounty_Reward_Setting^/?i^Bounty_Reward_Setting^/i^Bounty_Reward_Setting^;
!!FU(Bounty_NormalizeSelection):P;


!?FU(bounty_SaveOptionsToIni);
!!VR(filePath:z):S^Runtime/bounty config.ini^;
!!FU(WriteIniInts):P(filePath)/^bounty^/
  ^Bounty_Reward_Setting^/i^Bounty_Reward_Setting^/;
!!FU(SaveIni):P(filePath);


* Load the global setting when ERA initializes the scripts
!?PI;
!!FU(bounty_LoadOptionsFromIni):P;
