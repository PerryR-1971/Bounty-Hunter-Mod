!#SN:W^Bounty_Hunter_Mod_Active^/1;         [Set the mod active]

*On game enter define the gold reward per creature depending on settings
!?FU(OnGameEnter);

!!SN:W^Bounty_Reward_Setting^/?y1;

!!if&y1=1;                              [Easy]
  !!SN:W^Bounty_Reward_Creature_Level_0^/5; [Reward for Level 1 Creatures is 5 Gold]
  !!SN:W^Bounty_Reward_Creature_Level_1^/15;
  !!SN:W^Bounty_Reward_Creature_Level_2^/20;
  !!SN:W^Bounty_Reward_Creature_Level_3^/30;
  !!SN:W^Bounty_Reward_Creature_Level_4^/40;
  !!SN:W^Bounty_Reward_Creature_Level_5^/50;
  !!SN:W^Bounty_Reward_Creature_Level_6^/70;
  !!SN:W^Bounty_Reward_Creature_Level_7^/150;
  !!SN:W^Bounty_Reward_Creature_Level_8^/300; [Reward for legendary bounty creatures]
  !!SN:W^Bounty_Reward_per_month^/1000; [Base gold reward per game month]
!!en;

!!if&y1=2;                              [Normal]
  !!SN:W^Bounty_Reward_Creature_Level_0^/10; [Reward for Level 1 Creatures is 10 Gold]
  !!SN:W^Bounty_Reward_Creature_Level_1^/25;
  !!SN:W^Bounty_Reward_Creature_Level_2^/40;
  !!SN:W^Bounty_Reward_Creature_Level_3^/60;
  !!SN:W^Bounty_Reward_Creature_Level_4^/80;
  !!SN:W^Bounty_Reward_Creature_Level_5^/100;
  !!SN:W^Bounty_Reward_Creature_Level_6^/140;
  !!SN:W^Bounty_Reward_Creature_Level_7^/200;
  !!SN:W^Bounty_Reward_Creature_Level_8^/500; [Reward for legendary bounty creatures]
  !!SN:W^Bounty_Reward_per_month^/2000; [Base gold reward per game month]
!!en;

!!if&y1=3;                              [Hard]
  !!SN:W^Bounty_Reward_Creature_Level_0^/20; [Reward for Level 1 Creatures is 10 Gold]
  !!SN:W^Bounty_Reward_Creature_Level_1^/50;
  !!SN:W^Bounty_Reward_Creature_Level_2^/80;
  !!SN:W^Bounty_Reward_Creature_Level_3^/120;
  !!SN:W^Bounty_Reward_Creature_Level_4^/160;
  !!SN:W^Bounty_Reward_Creature_Level_5^/200;
  !!SN:W^Bounty_Reward_Creature_Level_6^/300;
  !!SN:W^Bounty_Reward_Creature_Level_7^/400;
  !!SN:W^Bounty_Reward_Creature_Level_8^/1000; [Reward for legendary bounty creatures]
  !!SN:W^Bounty_Reward_per_month^/4000; [Base gold reward per game month]
!!en;


****************************************************************************************************
*Get the reward level of a creature. Creatures with exceptionally high HP use the two elite levels.
!?FU(Bounty_Get_Creature_Reward_Level);

!!MA:Lx1/?x2;                            [Get the regular creature level]
!!MA:Px1/?y1;                            [Get the creature's base HP]
!!VRx2&y1>=500:S7;                       [Elite bounty level]
!!VRx2&y1>=750:S8;                       [Legendary bounty level]


****************************************************************************************************
*Get and store the player's hunter rank from the number of successfully completed contracts.
*x1 = player, x2 = rank (0 none, 1 novice, 2 skilled, 3 master, 4 legendary)
!?FU(Bounty_Get_Hunter_Rank);

!!SN:W^Bounty_Completed_Contracts_Player_%X1^/?y1;
!!VRx2:S0;                               [No rank]
!!VRx2&y1>=1:S1;                         [Novice Hunter]
!!VRx2&y1>=4:S2;                         [Skilled Hunter]
!!VRx2&y1>=10:S3;                        [Master Hunter]
!!VRx2&y1>=20:S4;                        [Legendary Hunter]
!!SN:W^Bounty_Hunter_Rank_Player_%X1^/x2;


****************************************************************************************************
*Apply the player's hunter-rank bonus to the creature-dependent part of the gold bounty.
*x1 = player, x2 = base gold per creature, x3 = adjusted gold per creature
!?FU(Bounty_Apply_Hunter_Gold_Bonus);

!!FU(Bounty_Get_Hunter_Rank):Px1/?y1;
!!VRy2:S0;
!!VRy2&y1=1:S5;                         [Novice: +5%]
!!VRy2&y1=2:S10;                        [Skilled: +10%]
!!VRy2&y1=3:S15;                        [Master: +15%]
!!VRy2&y1=4:S25;                        [Legendary: +25%]
!!VRx3:Sx2;
!!VRy3:Sx2*y2:100;
!!VRx3:+y3;


****************************************************************************************************
*Return the rank-based modifiers for special rewards and fixed reward tokens.
*x1 = player, x2 = reward already claimed this week, x3 = reward-value bonus, x4 = token bonus
!?FU(Bounty_Get_Hunter_Reward_Modifiers);

!!FU(Bounty_Get_Hunter_Rank):Px1/?y1;
!!VRx3:S0;
!!VRx4:S0;
!!VRx3&y1>=3:S5;                        [Master and Legendary: +5 points toward special rewards]
!!VRx4&x2=0/y1>=2:+1;                   [Skilled and higher: +1 token on the first weekly hand-in]
!!VRx4&x2=0/y1>=4:+1;                   [Legendary: one additional token]


****************************************************************************************************
*Calculate the rank-dependent cost of rerolling the shared weekly bounty.
*x1 = player, x2 = reroll cost
!?FU(Bounty_Get_Reroll_Cost);

!!VRx2:S2500;
!!VRy1:Si^timerMonth^;
!!VRy1:*2500;
!!VRx2:+y1;                             [Base cost: 2500 + 2500 per game month]
!!FU(Bounty_Get_Hunter_Rank):Px1/?y2;
!!VRx2&y2=2:*75:100;                    [Skilled: 25% discount]
!!VRx2&y2=3:*50:100;                    [Master: 50% discount]
!!VRx2&y2=4:S0;                         [Legendary: free]


****************************************************************************************************
*Count the first successful contract hand-in of the week and announce a newly earned rank.
*x1 = player
!?FU(Bounty_Register_Completed_Contract);

!!FU(Bounty_Get_Hunter_Rank):Px1/?y1;    [Get old rank]
!!SN:W^Bounty_Completed_Contracts_Player_%X1^/?y2;
!!VRy2:+1;
!!SN:W^Bounty_Completed_Contracts_Player_%X1^/y2;
!!FU(Bounty_Get_Hunter_Rank):Px1/?y3;    [Calculate and store new rank]

!!SN:W^Bounty_Special_Week^/?y4;
!!if&y4=1;
  !!SN:W^Bounty_Elite_Contracts_Player_%X1^/?y5;
  !!VRy5&y5<0:S0;
  !!VRy5:+1;
  !!SN:W^Bounty_Elite_Contracts_Player_%X1^/y5;
!!en;

!!if&y3>y1;
  !!SN&y3=1:T^bounty_h.Hunter_Rank_Novice^/?z1;
  !!SN&y3=2:T^bounty_h.Hunter_Rank_Skilled^/?z1;
  !!SN&y3=3:T^bounty_h.Hunter_Rank_Master^/?z1;
  !!SN&y3=4:T^bounty_h.Hunter_Rank_Legendary^/?z1;
  !!SN&y3=1:T^bounty_h.Ranks_Novice_Body^/?z3;
  !!SN&y3=2:T^bounty_h.Ranks_Skilled_Body^/?z3;
  !!SN&y3=3:T^bounty_h.Ranks_Master_Body^/?z3;
  !!SN&y3=4:T^bounty_h.Ranks_Legendary_Body^/?z3;
  !!SN:T^bounty_h.Hunter_Rank_Promotion^/?z2/^rank^/z1/^completed^/y2/^bonuses^/z3;
  !!IF:M^%Z2^;
!!en;


