!!SN:W^Bounty_Profile_%X1_Weight_Resources^/?y1;
!!SN:W^Bounty_Profile_%X1_Weight_Artifacts^/?y2;
!!SN:W^Bounty_Profile_%X1_Weight_Training^/?y3;
!!SN:W^Bounty_Profile_%X1_Weight_ACM^/?y4;
!!VRy1&y1<0:S0;
!!VRy2&y2<0:S0;
!!VRy3&y3<0:S0;
!!VRy4&y4<0:S0;
