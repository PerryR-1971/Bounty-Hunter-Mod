!!VRy5:Sy1+y2+y3+y4;
!!VR(selectedReward):S-1;
!!FU&y5<=0:E;

!!VRy6:R0/1/y5 -1;
!!VRy7:S0;                              [Selected category]
!!VRy8:Sy1;
!!VRy7&y6<y8:S1;                        [Resources]
!!VRy8:+y2;
!!VRy7&y7=0/y6<y8:S2;                   [Artifacts]
!!VRy8:+y3;
!!VRy7&y7=0/y6<y8:S3;                   [Training and knowledge]
!!VRy8:+y4;
!!VRy7&y7=0/y6<y8:S4;                   [ACM rewards]
!!FU(Bounty_Select_Weighted_Reward):P(acmActive)/y7/?(selectedReward);


****************************************************************************************************
*Select one reward from the chosen category using the individual reward weights.
*x1 = Advanced Classes Mod active, x2 = category, x3 = selected reward ID
!?FU(Bounty_Select_Weighted_Reward);
!#VA(acmActive:x) (category:x) (selectedReward:x) (rewardList:y) (weightList:y) (listSize:y) (totalWeight:y) (weight:y) (roll:y) (cumulativeWeight:y);

!!VR(selectedReward):S-1;
!!FU(NewIntArray):P?(rewardList);
!!FU(NewIntArray):P?(weightList);

!!if&(category)=1;
  !!SN:W^Bounty_Reward_Weight_Resources^/?y20;
  !!FU(Array_Push):P(rewardList)/1;
  !!FU(Array_Push):P(weightList)/y20;
!!en;

!!if&(category)=2;
  !!SN:W^Bounty_Reward_Weight_Artifact^/?y20;
  !!FU(Array_Push):P(rewardList)/4;
  !!FU(Array_Push):P(weightList)/y20;
!!en;

!!if&(category)=3;
  !!SN:W^Bounty_Reward_Weight_Primary_Skill^/?y20;
  !!SN:W^Bounty_Reward_Weight_Experience^/?y21;
  !!SN:W^Bounty_Reward_Weight_Spell^/?y22;
  !!FU(Array_Push):P(rewardList)/2/3/5;
  !!FU(Array_Push):P(weightList)/y20/y21/y22;
!!en;

!!if&(category)=4/(acmActive)=1;
  !!SN:W^Bounty_Reward_Weight_ACM_Stats^/?y25;
  !!SN:W^Bounty_Reward_Weight_Magic_Pierce^/?y26;
  !!SN:W^Bounty_Reward_Weight_Spell_Upgrade^/?y27;
  !!SN:W^Bounty_Reward_Weight_Scouting^/?y28;
  !!SN:W^Bounty_Reward_Weight_Commander_Training^/?y29;
  !!SN:W^Bounty_Reward_Weight_Elemental_Mastery^/?y30;
  !!SN:W^Bounty_Reward_Weight_Luck_Chance^/?y31;
  !!SN:W^Bounty_Reward_Weight_Luck_Damage^/?y32;
  !!FU(Array_Push):P(rewardList)/6/7/8/9/10/11/12/13;
  !!FU(Array_Push):P(weightList)/y25/y26/y27/y28/y29/y30/y31/y32;
!!en;

!!SN:M(weightList)/?(listSize);
!!VR(totalWeight):S0;
!!re i/0/(listSize)/1/-1;
  !!SN:M(weightList)/i/?(weight);
  !!VR(weight)&(weight)<0:S0;
  !!VR(totalWeight):+(weight);
!!en;
!!FU&(totalWeight)<=0:E;

!!VR(roll):R0/1/(totalWeight) -1;
!!VR(cumulativeWeight):S0;
!!re i/0/(listSize)/1/-1;
  !!SN:M(weightList)/i/?(weight);
  !!VR(weight)&(weight)<0:S0;
  !!VR(cumulativeWeight):+(weight);
  !!if&(selectedReward)=-1/(roll)<(cumulativeWeight);
    !!SN:M(rewardList)/i/?(selectedReward);
  !!en;
!!en;


