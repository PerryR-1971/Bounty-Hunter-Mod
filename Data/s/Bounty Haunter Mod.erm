****************************************************************************************************
*Reroll the global weekly bounty once, but only before any player has collected bounty kills.
!?FU(Bounty_Reroll_Weekly_Target);

!!OW:C?y10;                             [Get the player who is using the shared reroll]
!!FU(Bounty_Get_Hunter_Rank):Py10/?y11;
!!if&y11<1;
  !!SN:T^bounty_h.Reroll_Locked^/?z1;
  !!IF:M^%Z1^;
  !!FU:E;
!!en;

!!SN:W^Bounty_Reroll_Used^/?y1;
!!if&y1=1;
  !!SN:T^bounty_h.Reroll_Already_Used^/?z1;
  !!IF:M^%Z1^;
  !!FU:E;
!!en;

!!VRy2:S0;                              [Combined bounty kills of all players]
!!re y3/0/7;
  !!SN:W^Bounty_Counter_Owner_%Y3^/?y4;
  !!SN:W^Bounty_Reward_Player_%Y3^/?y9;
  !!VRy2:+y4;
  !!VRy2&y9=1:+1;                       [Also block after a player has already claimed a reward]
!!en;

!!if&y2>0;
  !!SN:T^bounty_h.Reroll_Blocked^/?z1;
  !!IF:M^%Z1^;
  !!FU:E;
!!en;

!!SN:W^Bounty_creature_0^/?y5;          [Show the current target in the confirmation]
!!FU(Bounty_Get_Reroll_Cost):Py10/?y12;
!!OW:Ry10/6/?y13;
!!if&y13<y12;
  !!SN:T^bounty_h.Reroll_Not_Enough_Gold^/?z1/^cost^/y12/^gold^/y13;
  !!IF:M^%Z1^;
  !!FU:E;
!!en;

!!SN:T^bounty_h.Reroll_Confirm^/?z1/^cost^/y12;
!!IF:Q1/21/y5/2^%Z1^;
!!FU&-1:E;                              [Exit if the player declines]

!!VRy13:Sy12*-1;
!!OW:Ry10/6/dy13;                       [Pay the rank-dependent reroll cost]
!!FU(Bounty_Generate_Weekly_Target):Py5;
!!SN:W^Bounty_Reroll_Used^/1;

!!re y3/0/7;
  !!SN:W^Bounty_Hunter_Player_%Y3^/0;   [Other players must see the changed weekly announcement]
!!en;
!!OW:C?y10;
!!SN:W^Bounty_Hunter_Player_%Y10^/1;    [The rerolling player sees the new target in this dialog]

!!SN:W^Bounty_creature_0^/?y6;
!!SN:W^Bounty_creature_1^/?y7;
!!SN:W^Bounty_Special_Week^/?y8;
!!VRy6&y6<0:S0;
!!VRy7&y7<0:S0;
!!VRy11:Sy6+2;
!!VRy12:Sy7+2;
!!DL213:A3/4/y11/1;
!!DL213&y8=0:A4/4/y12/1;
!!DL213&y8=1:A4/4/0/1;
