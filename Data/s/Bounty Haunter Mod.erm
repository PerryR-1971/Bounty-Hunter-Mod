****************************************************************************************************
*Generate the weekly bounty and reset all player-specific weekly progress.
!?FU(OnEveryDay)&i^timerIsAi^=0/i^timerWeekDay^=1/i^timerOnce^=1; [Trigger once on Monday]
!#VA(timerWeek:x);

!!FU(Bounty_Generate_Weekly_Target):P-1; [No previous target has to be excluded]
!!SN:W^Bounty_Reroll_Used^/0;            [Allow one global reroll during the new week]

!!re y30/0/7;
  !!SN:W^Bounty_Hunter_Player_%Y30^/0;  [reset flag for bounty hunter splash screen once every week]
  !!SN:W^Bounty_Counter_Owner_%Y30^/0;  [reset groups counter]
  !!SN:W^Bounty_Reward_Player_%Y30^/0;  [Reset flag if a reward has already been given this week]
!!en;


****************************************************************************************************
*Generate a random not upgraded or elite creature as the current bounty.
*x1 = previous target to exclude, or -1 when every target is allowed.
!?FU(Bounty_Generate_Weekly_Target);

!!VRy80:S0;                              [No valid different target selected yet]
!!re y81/0/19;                           [Try up to 20 times to avoid selecting the previous target]
  !!if&y80=0;
    !!VRy3:S0R8;                         [Generate random town number 0-8]
    !!VRy4:S0R6;                         [Get random dwelling number 0-6]

    !!VRy4&i^timerWeek^=1:S0;            [In the first week get only level 1 creatures]
    !!VRy4&i^timerWeek^=2:S0;            [In the second week get only level 1 creatures]
    !!VRy4&i^timerWeek^=3:S0R1;          [In the third week get only level 1-2 creatures]
    !!VRy4&i^timerWeek^=4:S0R1;          [In the fourth week get only level 1-2 creatures]
    !!VRy4&i^timerWeek^=5:S0R2;          [In the fifth week get only level 1-3 creatures]
    !!VRy4&i^timerWeek^=6:S0R3;          [In the sixth week get only level 1-4 creatures]
    !!VRy4&i^timerWeek^=7:S0R3;          [In the seventh week get only level 1-4 creatures]
    !!VRy4&i^timerWeek^=8:S0R4;          [In the eighth week get only level 1-5 creatures]
    !!VRy4&i^timerWeek^=9:S0R5;          [In the ninth week get only level 1-6 creatures]
    !!VRy4&i^timerWeek^=10:S0R5;         [In the tenth week get only level 1-6 creatures]
    !!VRy5:S0;                           [Non-upgraded variant 0]
    !!UN:Ty3/y4/y5/?y6;                  [Get creature ID for this week's bounty]

    !!FU(GetUpgradedMonster):Py6/?y7;    [Check for Upgrade creature ID]
    !!FU(GetUpgradedMonster):Py7/?y8;    [Check for Upgrade creature ID]

    !!SN:W^Bounty_Special_Week^/0;        [Default to the regular bounty selection]
    !!SN:W^Typhon_Third_Upgrade_Mod_Active^/?y91;
    !!VRy90:S0R99;                       [Roll the 5% elite bounty chance]

    !!if&y91=1/y90<5/i^timerWeek^>=10;
      !!FU(Bounty_Select_Elite_Creature):P?y6;
      !!VRy7:Sy6;                        [Use only the selected elite creature]
      !!VRy8:Sy6;
      !!SN:W^Bounty_Special_Week^/1;
    !!en;

    !!VRy80&y6<>x1:S1;                  [Accept only a target different from the previous one]
  !!en;
!!en;

!!SN:W^Bounty_creature_0^/y6;           [Set base or elite creature ID]
!!SN:W^Bounty_creature_1^/y7;           [Set first upgrade or elite creature ID]
!!SN:W^Bounty_creature_2^/y8;           [Set save second upgrade creature ID]

* Reward value is a random value that determines the size of the reward. The higher the creature level the better the chance for a higher reward value
!!FU(Bounty_Get_Creature_Reward_Level):Py6/?y50;
!!SN:W^Bounty_Reward_Creature_Level_%Y50^/?y51; [Get Gold reward for the bounty]
!!VRy20:S0;
!!VRy20&y50=0:S5;                       [Level 1]
!!VRy20&y50=1:S10;                      [...]
!!VRy20&y50=2:S15;                      [...]
!!VRy20&y50=3:S25;                      [...]
!!VRy20&y50=4:S35;
!!VRy20&y50=5:S40;
!!VRy20&y50=6:S50;
!!VRy20&y50=7:S55;                      [Elite bounty]
!!VRy20&y50=8:S70;                      [Legendary bounty]
!!VRy21:S0R50+y20;                      [Generate random value from 0 to 50 and add creature level modifier]
!!SN:W^Bounty_Reward_Value^/y21;        [Save reward value]


****************************************************************************************************
*every first click on new week in new town shows bounties for that week
!?FU(OnTownMouseClick);                 [trigger on clicking in town screen]

!!CA-1:U?y30;                           [get town id]
!!CA-1:T?y2;                            [get town type]
!!CA-1:O?y3;                            [owner of the town: y-2]
!!OW:C?y10;                             [current player: y-3]
!!FU&y3<>y10:E;                         [Exit if player doesn't own town]

!!SN:W^Bounty_Hunter_Player_%Y10^/?y99; [Get weekly flag for player and Exit if it has already been shown]
!!if&y99=0;  
  !!SN:W^Bounty_creature_0^/?y1; !!SN:W^Bounty_creature_1^/?y2; !!SN:W^Bounty_creature_2^/?y3; [get creatures]
  !!VRy1&y1<0:S0; !!VRy2&y2<0:S0; !!VRy3&y3<0:S0; [avoid negative creature IDs for pictures defs]
  !!VRy4:Sy1+2; !!VRy5:Sy2+2; !!VRy6:Sy3+2;
  !!UN:N3/z2/y1/1;                      [get names of first creature]
  !!UN:N3/z3/y2/1;                      [get names of second creature]
  !!UN:N3/z4/y3/1;                      [get names of third creature]

  !!SN:W^Bounty_Reward_Value^/?y21;     [Getreward value]
  !!SN&y21>=0:T^bounty_h.unlikely^/?z9; [get text from json]
  !!SN&y21>=20:T^bounty_h.low^/?z9;     [get text from json]
  !!SN&y21>=40:T^bounty_h.medium^/?z9;  [get text from json]
  !!SN&y21>=60:T^bounty_h.likely^/?z9;  [get text from json]
  !!SN&y21>=80:T^bounty_h.very high^/?z9;[get text from json]
  !!SN&y21>=100:T^bounty_h.guaranteed^/?z9; [get text from json]

  !!SN:W^Bounty_Reward_Player_%Y10^/?y45;[Check if a reward has already been given this week]
  !!VRy21&y45=1:-30;                    [If a reward has already been given this week, reduce the chance for further rewards by 30%]
  !!VRy21&y21<0:S0;
  !!FU(Bounty_Get_Hunter_Reward_Modifiers):Py10/y45/?y61/?y62;
  !!VRy21:+y61;

  !!VRy60&y21>=100:S4;                  [4 reward token]
  !!VRy60&y21<100/y21>=70:S3;           [3 reward token]
  !!VRy60&y21<70/y21>=50:S2;            [2 reward token]
  !!VRy60&y21<50/y21>=35:S1;            [1 reward token]
  !!VRy60&y21<35/y21>=0:S0;             [0 reward token]
  !!VRy60:+y62;
  !!VRy60&y45=1:S0;                     [Only the first hand-in of the week awards tokens]
  !!SN:W^Bounty_Tokens_Player_%Y10^/?y63;
  !!VRy63&y63<0:S0;

  !!FU(Bounty_Get_Creature_Reward_Level):Py1/?y50;
  !!SN:W^Bounty_Reward_Creature_Level_%Y50^/?y51; [Get Gold reward for the bounty]
  !!FU(Bounty_Apply_Hunter_Gold_Bonus):Py10/y51/?y51;

  !!SN:W^Bounty_Special_Week^/?y98;
  !!if&y98=1;
    !!SN:P^13_01.wav^;                  [play Janice voice for an elite bounty announcement]
    !!SN:T^bounty_h.Town_Screen_Elite^/?z8/^pay^/y51/^token^/y60/^balance^/y63 Iz8/?z8;
    !!IF:M^%Z8^;                        [show message]
  !!el;
    !!SN:P^Quest.wav^;                  [play quest sound for the regular weekly bounty announcement]
    !!SN:W^Typhon_Third_Upgrade_Mod_Active^/?y99;
    !!if&y99=0;                         [if message hasnt been shown, show once now for two creatures]
      !!SN:T^bounty_h.Town_Screen_No_Tum^/?z8/^pay^/y51/^token^/y60/^balance^/y63 Iz8/?z8; [get text from json]
      !!IF:M^%Z8^;                      [show message]
    !!en;
    !!if&y99=1;                         [show picture with three creatures]
      !!SN:T^bounty_h.Town_Screen_Tum^/?z8/^pay^/y51/^token^/y60/^balance^/y63 Iz8/?z8; [get text from json]
      !!IF:M^%Z8^;                      [show message]
    !!en;
  !!en;
  !!SN:W^Bounty_Hunter_Player_%Y10^/1;  [Set flag that splash screen was shown to that player]
!!en;
!!CM:S?y1;                              [Get what type of click]
!!FU&y1<>14:E;                          [exit if not right click]
!!CM:I?y1;                              [Get what type of click]
!!FU&y1<10:E;                           [abort if not town hall type]
!!FU&y1>13:E;                           [abort if not town hall type]
!!FU(ACM_Bounty_Hunter_Townhall):P;     [call fct]


